# ── Substituted by configure ──────────────────────────────────────────
NVCC            = @NVCC@
CUDA_CPPFLAGS   = @CUDA_CPPFLAGS@
CUDA_LIBS       = @CUDA_LIBS@
CUDA_ARCH_FLAGS = @CUDA_ARCH_FLAGS@

# ── Compiler / linker flags ───────────────────────────────────────────
PKG_CPPFLAGS = @GDAL_CPPFLAGS@ $(CUDA_CPPFLAGS) -I../inst/include
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS) -pthread
PKG_LIBS     = @GDAL_LIBS@ $(SHLIB_OPENMP_CXXFLAGS) -pthread $(CUDA_LIBS)

# ── Object list (enumerated by configure — no GNU Make extensions) ────
OBJECTS = @ALL_OBJECTS@

# ── CUDA compilation rule (only present when NVCC was found) ──────────
# When CUDA is absent this section is empty and g++ compiles
# bioclim_cuda.cpp to an empty object (#ifdef HAVE_CUDA guard).
@CUDA_NVCC_RULE@
